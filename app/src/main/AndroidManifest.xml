<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="com.starpilot.auto" /></queries>
    <application android:theme="@style/AppTheme" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:allowBackup="false">
        <activity android:name="com.starpilot.auto.ReviewSetupActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1" />
        <meta-data android:name="androidx.car.app.theme" android:resource="@style/CarAppTheme" />
        <service android:name="com.starpilot.auto.GalaxyCarAppService" android:exported="true" android:label="@string/app_name" android:icon="@mipmap/ic_launcher">
            <meta-data android:name="com.starpilot.auto.bridge.version" android:value="1" />
            <intent-filter><action android:name="androidx.car.app.CarAppService" /><category android:name="androidx.car.app.category.IOT" /></intent-filter>
        </service>
    </application>
</manifest>
