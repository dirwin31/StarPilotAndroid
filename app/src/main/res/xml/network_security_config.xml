<network-security-config>
    <!-- Android has no CIDR matcher. MainActivity enforces numeric RFC1918 origins
         and intercepts every WebView request; the service uses only the fixed AP. -->
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="false"><domain includeSubdomains="true">firestar.link</domain></domain-config>
</network-security-config>
