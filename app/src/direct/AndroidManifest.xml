<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application>
        <receiver android:name=".AppInstallReceiver" android:exported="false" />
        <receiver android:name=".AppUpdateCompletion" android:exported="false">
            <intent-filter><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
        <service android:name=".AppUpdateJob" android:exported="true" android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
