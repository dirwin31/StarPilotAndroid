{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "galaxy-sentry-relay",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "AUTO_ENROLL": "true",
    "AUTO_ENROLL_DAILY_LIMIT": "500",
    "AUTO_ENROLL_IP_DAILY_LIMIT": "20",
    "MAX_INSTALLATIONS": "5000",
    "DAILY_SEND_LIMIT": "20000",
    "FCM_PROJECT_ID": "starpilot-sentry",
    "IOS_APP_IDS": "link.galaxy.bluetooth.natehuby76"
  },
  "durable_objects": { "bindings": [{ "name": "ENROLLMENT", "class_name": "EnrollmentRegistry" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EnrollmentRegistry"] }],
  "ratelimits": [{ "name": "INGRESS", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }]
}
